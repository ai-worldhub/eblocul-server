{
    "name": "server",
    "version": "0.0.1",
    "description": "",
    "author": "AI World Hub",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "postinstall": "prisma generate",
        "build": "prisma generate && nest build",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "postprisma:migrate": "prisma generate",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "oxlint -c oxlint.json --type-aware src/ test/ scripts/",
        "lint:config": "node scripts/write-oxlint-config.ts && prettier --write oxlint.json",
        "knip": "knip",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
        "typecheck": "tsc --noEmit",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"*.{ts,json,md}\"",
        "prepare": "git config hook.checks.event pre-commit && git config hook.checks.command node_modules/.bin/lint-staged || true"
    },
    "dependencies": {
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/platform-express": "^12.0.1",
        "@nestjs/swagger": "^12.0.2",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "nestjs-pino": "^5.3.1",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "prisma": "^7.10.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.2",
        "knip": "^6.39.0",
        "lint-staged": "^17.6.0",
        "oxlint": "^1.58.0",
        "oxlint-tsgolint": "^7.0.2003",
        "prettier": "^3.4.2",
        "supertest": "^7.0.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2"
    },
    "overrides": {
        "mysql2": "^3.24.4",
        "deepmerge-ts": "^8.0.2"
    }
}
