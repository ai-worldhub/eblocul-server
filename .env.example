LOG_FORMAT=pretty
FORCE_COLOR=1

NODE_ENV=lab
SERVER_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eblocul-server?schema=public

WEB_PANEL_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
# One password of every seeded account (admin@example.com, chief@example.com, zone-admin@example.com, chairman@example.com): at least 10 characters, letters and digits. Choose your own.
SEED_ADMIN_PASSWORD=

# Reverse proxies between the internet and the application: 0 — none, 1 — one nginx or load balancer, 2 — a CDN and nginx.
TRUSTED_PROXY_HOPS=0
# Key of the rate limit fingerprints, at least 32 characters. Generate your own: openssl rand -base64 32
THROTTLE_KEY_SECRET=

JOBS_WORKER_CLASSES=p0,p1,p2,p3,p4_short,p4_long
JOBS_WORKER_CONCURRENCY=4
JOBS_POLL_INTERVAL_MS=1000

MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_FROM=no-reply@eblocul.md
