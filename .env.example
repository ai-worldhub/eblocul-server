LOG_FORMAT=pretty
FORCE_COLOR=1

NODE_ENV=lab
SERVER_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eblocul-server?schema=public

JOBS_SCHEDULE=on
JOBS_RELAY_INTERVAL_SECONDS=5

# 32 characters or more: openssl rand -hex 32
AUTH_JWT_SECRET=

MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_FROM=no-reply@eblocul.md
