LOG_FORMAT=pretty
FORCE_COLOR=1

NODE_ENV=lab
SERVER_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eblocul-server?schema=public

WEB_PANEL_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
# Password of the seeded administrator admin@example.com: at least 10 characters, letters and digits. Choose your own.
SEED_ADMIN_PASSWORD=

JOBS_WORKER_CLASSES=p0,p1,p2,p3,p4_short,p4_long
JOBS_WORKER_CONCURRENCY=4
JOBS_POLL_INTERVAL_MS=1000

MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_FROM=no-reply@eblocul.md
